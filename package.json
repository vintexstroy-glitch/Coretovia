{
  "name": "coretovia",
  "version": "0.0.1-skelet",
  "private": true,
  "type": "module",
  "description": "Coretovia · Книгата е Заданието · осем прозореца, един Журнал, една Порта",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
