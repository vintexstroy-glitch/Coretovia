  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.2.0",
    "fake-indexeddb": "6.2.5",
    "knip": "6.34.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
