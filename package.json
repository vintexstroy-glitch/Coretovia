    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "proba": "npm run build && node proba/prohod.ts",
    "chistota": "node stroezh/chistota.mjs",
    "chestnost": "node stroezh/chestnost.mjs",
    "sloeve": "depcruise --config .dependency-cruiser.cjs src app",
    "litsenzi": "node stroezh/litsenzi.mjs",
    "stil": "biome check .",
    "mostra": "node stroezh/mostra-kniga.mjs",
    "dumi": "node stroezh/dumi-ot-knigata.mjs",
